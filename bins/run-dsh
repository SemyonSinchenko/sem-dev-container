#!/usr/bin/env python3
"""
run-dsh — run the DeepSeek Harness dev container (dev-dsh) with host
caches/state mounted, attached to its logs.

dsh (https://github.com/deepseek-ai/deepseek-harness) serves a web UI and
an RPC surface used by clients such as dsh-emacs
(https://github.com/vritser/dsh-emacs). The container binds the harness to
its own address on the container-side port 3080; run-dsh publishes it on
the host at 127.0.0.1:<port>, picking a free port from the rare range
30780-30789 so up to 10 sessions can run in parallel (one project folder
per container).

Project data is kept in <project>/.dsh (sessions, workspace registry and
attachments); ~/.dsh is mounted at /root/.dsh only for shared, project-
agnostic state (profiles, plugins, provider credentials, global
instructions and skills). The launcher exports DSH_PROJECT_* variables and
the container entry applies a patch that points DSH's project-data roots at
<project>/.dsh, so the harness starts with the project as its one
workspace. Add .dsh/ to the project's .gitignore.

The launcher is foreground by design: it streams the server logs, and
Ctrl-D (stdin EOF) or Ctrl-C (SIGINT) stops the harness and removes the
container. The server prints its URL with the launch token, e.g.

    dsh web: http://127.0.0.1:3080/?token=...

After that line run-dsh prints three host-side lines: the complete URL with
the token (clickable), the published host port, and the token. The last two
are raw values for monitoring scripts. See README.md.

`run-dsh --acp` runs the same container (same project mount, state, caches and
environment) as a foreground ACP stdio server instead: no port is published,
no URL or token is printed, and stdin/stdout are inherited by
`dsh-acp-entry` -> `dsh --profile acp`. The launcher execs podman/docker, so
the ACP client (agent-shell/acp.el in Emacs) owns the pipes, signals, and exit
status. stdout is protocol-only; diagnostics go to stderr. No pseudo-TTY is
allocated even when stdin is a terminal, because terminal echo and CR/LF
translation corrupt ACP framing.

Inside the container the image-local dev-container plugin adds the runtime
facts (disposable root container, /target, read-only .git) to the system
prompt and denies git writes with a clear message; see dsh/dev-container.mjs.

Sessions start unrestricted: the launcher exports
DSH_PERMISSION_MODE=danger-full-access, which turns DSH's file sandbox off
and its approval policy to `never`, so the agent never has to ask for
permission inside this disposable container. Isolation is the operator's
responsibility. Override one run with
`--env DSH_PERMISSION_MODE=workspace-write` (or switch the session's
`/permission` preset in the Web UI); see README.md.

Examples:
  run-dsh                       # start dsh web in $PWD and follow its logs
  run-dsh -- --port 1234        # flags after -- go to `dsh web` (container side)
  run-dsh --acp                 # serve ACP over stdio instead (agent-shell/acp.el)
  run-dsh --shell               # drop into bash in the container (no server)
  run-dsh --exec dsh --help     # run an arbitrary command instead of the server
  run-dsh --engine docker       # use docker instead of podman
  run-dsh --dry-run             # print the command instead of running it

Script options must come before `--` or `--exec`; everything after is
container-side.
"""

from __future__ import annotations

import argparse
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import urllib.parse
from pathlib import Path

IMAGE = "dev-dsh"               # default image (override with --image)
ENTRY = "dsh-web-entry"         # foreground wrapper installed by dsh/Dockerfile
ACP_ENTRY = "dsh-acp-entry"     # foreground ACP stdio entry installed alongside it
STATE_DIR = ".dsh"              # host $HOME/.dsh  ->  /root/.dsh (shared DSH_HOME)
PROJECT_STATE_DIR = ".dsh"      # <project>/.dsh: sessions/storages/attachments
AGENTS_DIR = ".agents"          # host $HOME/.agents (dsh AGENTS_HOME)
CONTAINER_PORT = 3080           # dsh web port inside the container (fixed)
HOST_BIND = "127.0.0.1"         # host-side publish address; must stay loopback:
                                # dsh-emacs and the browser run here, and pasta's
                                # --host-lo-to-ns-lo (see the server branch in
                                # main) delivers connections to this loopback
                                # address into the container's loopback, where
                                # dsh — loopback-only by design — listens. The
                                # bind feeds -p and --trusted-host together.
PORT_BASE = 30780               # rare host port range for parallel sessions:
PORT_COUNT = 10                 # 30780-30789, below the ephemeral range.
VOLUME_PREFIX = "dsh-target"    # named volume per project: dsh-target<escaped pwd> -> /target

# DSH permission policy: the sandbox mode every session starts in. The shipped
# base profile maps danger-full-access to approval=never; any other mode asks.
DEFAULT_PERMISSION_MODE = "danger-full-access"

# `dsh web` prints its container-side launch URL, e.g.
#   dsh web: http://127.0.0.1:3080/?token=...
# The token is per run; the host port differs (run-dsh publishes it).
DSH_WEB_URL_RE = re.compile(r"dsh web:\s+(?P<url>https?://\S+)")

# Env vars copied into the container when set on the host (`-e KEY` passes
# the host value through; unset keys are skipped). Same list as run-pi/run-pa;
# dsh reads provider keys from its settings (Web UI -> Models) and honors
# per-provider apiKeyEnv overrides.
PASSTHROUGH_KEYS = [
    "ZAI_API_KEY",
    "DEEPSEEK_API_KEY",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "OPENROUTER_API_KEY",
    "GEMINI_API_KEY",
    "XAI_API_KEY",
    "PRIME_API_KEY",
]


def resolve_engine(engine: str) -> str:
    """Pick a container engine: explicit choice, or auto (podman -> docker)."""
    if engine and engine != "auto":
        return engine
    for candidate in ("podman", "docker"):
        if shutil.which(candidate):
            return candidate
    sys.exit("error: no container engine found (tried podman, docker)")


def ensure_mount_sources(home: Path, pwd: Path) -> None:
    """Create host dirs that will be bind-mounted (podman refuses to create them)."""
    dirs = [
        pwd,
        pwd / PROJECT_STATE_DIR,
        home / STATE_DIR,
        home / AGENTS_DIR,
        home / ".cargo/registry",
        home / ".cache/coursier",
        home / ".ivy2",
        home / ".cache/uv",
        home / ".cache/pip",
        home / ".cache/pypoetry",
        home / ".m2/repository",
    ]
    for d in dirs:
        d.mkdir(parents=True, exist_ok=True)


def has_git_dir(pwd: Path) -> bool:
    """Whether the project has a .git to re-mount read-only (and report)."""
    return (pwd / ".git").exists()


def build_mounts(home: Path, pwd: Path, selinux: bool) -> list[str]:
    """-v specs: bind mounts (host:container) + the per-project named volume."""
    z = ":z" if selinux else ""
    specs = [
        f"{pwd}:{pwd}{z}",
        f"{home / STATE_DIR}:/root/{STATE_DIR}{z}",
        f"{home / AGENTS_DIR}:/root/{AGENTS_DIR}{z}",
        f"{home / '.cargo/registry'}:/usr/local/cargo/registry{z}",
        f"{home / '.cache/coursier'}:/cache/coursier{z}",
        f"{home / '.ivy2'}:/cache/ivy2{z}",
        f"{home / '.cache/uv'}:/cache/uv{z}",
        f"{home / '.cache/pip'}:/cache/pip{z}",
        f"{home / '.cache/pypoetry'}:/cache/poetry{z}",
        f"{home / '.m2/repository'}:/cache/maven{z}",
    ]
    # Re-mount .git read-only over the rw project mount above (a later -v
    # entry wins): the agent can read history and diffs, but every git write
    # (commit, push, stash, checkout, rebase) fails inside the container --
    # commits belong on the host, signed with the operator's key (see
    # dsh/dev-container.mjs). Skipped for non-git projects: podman would
    # create a stray .git/ dir in them.
    git_dir = pwd / ".git"
    if has_git_dir(pwd):
        specs.append(f"{git_dir}:{git_dir}:{'ro,z' if selinux else 'ro'}")
    # Named (docker-managed) volume, one per host project dir, so builds the
    # dsh agent runs in the workspace keep their target dir across runs.
    volume = VOLUME_PREFIX + str(pwd).replace("/", "_")
    specs.append(f"{volume}:/target")
    return specs


def build_envs(extra: list[str], *, forward_searxng: bool = False) -> list[str]:
    """-e specs: fixed, then passthrough keys set on the host, then --env extras.

    Kept in a dict keyed by variable name so a later --env entry replaces an
    earlier passthrough of the same key (last one wins).
    """
    envs: dict[str, str] = {
        "CARGO_TARGET_DIR": "CARGO_TARGET_DIR=/target",
        # The container is a single-purpose isolation boundary, so DSH starts
        # every session with its file sandbox off. The base profile derives
        # approval=never from this exact value, which also removes the
        # fail-closed approval path for sandbox escalations. A later
        # --env DSH_PERMISSION_MODE=... in `extra` replaces this default.
        "DSH_PERMISSION_MODE": f"DSH_PERMISSION_MODE={DEFAULT_PERMISSION_MODE}",
    }
    if forward_searxng:
        envs["SEARXNG_URL"] = "SEARXNG_URL=http://127.0.0.1:7331"
    for key in PASSTHROUGH_KEYS:
        if os.environ.get(key) is not None:
            envs[key] = key  # bare KEY: container copies the host value
    for spec in extra:
        envs[spec.split("=", 1)[0]] = spec
    return list(envs.values())


def permission_mode(extra: list[str]) -> str:
    """Effective DSH sandbox mode: the last --env DSH_PERMISSION_MODE wins.

    Mirrors build_envs' last-one-wins order (including a bare KEY, which passes
    the host value through) so the startup banner reports the real policy.
    """
    for spec in reversed(extra):
        key, sep, value = spec.partition("=")
        if key != "DSH_PERMISSION_MODE":
            continue
        if sep:
            return value
        return os.environ.get(key) or DEFAULT_PERMISSION_MODE
    return DEFAULT_PERMISSION_MODE


def pick_free_port() -> int:
    """First host port in the run-dsh range nothing is listening on yet."""
    for port in range(PORT_BASE, PORT_BASE + PORT_COUNT):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
            try:
                probe.bind((HOST_BIND, port))
            except OSError:
                continue
            return port
    sys.exit(
        f"error: host ports {PORT_BASE}-{PORT_BASE + PORT_COUNT - 1} are all busy; "
        "stop an old run-dsh session or raise PORT_COUNT"
    )


def host_link(port: int, token: str) -> str:
    """Host-side URL for the printed container launch URL."""
    return f"http://{HOST_BIND}:{port}/?token={urllib.parse.quote(token, safe='')}"


def write_out(text: str) -> None:
    """Write one line, starting it in column 0 when stdout is a terminal.

    `podman run -it`/`docker run -it` put the attached terminal in raw mode,
    which clears OPOST/ONLCR: a bare LF moves down but no longer returns to
    column 0. Every line would then begin where the previous one ended (the
    staircase in the startup banner). Prefix the write with CR so each line
    starts at column 0. When stdout is a pipe or file (monitoring scripts
    capturing the raw URL/port/token) nothing is added.
    """
    if sys.stdout.isatty():
        text = "\r" + text
    sys.stdout.write(text)
    sys.stdout.flush()


def emit_host_link(port: int, line: str) -> bool:
    """Print the host URL, port, and token once, after dsh prints its URL line."""
    match = DSH_WEB_URL_RE.search(line)
    if match is None:
        return False
    parsed = urllib.parse.urlparse(match.group("url"))
    token = urllib.parse.parse_qs(parsed.query).get("token", [None])[0]
    if not token:
        return False
    write_out(host_link(port, token) + "\n")
    write_out(f"{port}\n")
    write_out(token + "\n")
    return True


def run_streaming(cmd: list[str], port: int) -> int:
    """Stream the server logs, appending the host-ready link/port/token once."""
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        text=True,
        encoding="utf-8",
        errors="replace",
        bufsize=1,
    )
    assert proc.stdout is not None
    stdout = proc.stdout
    emitted = False

    def consume(echo: bool) -> None:
        nonlocal emitted
        for line in stdout:
            if echo:
                try:
                    write_out(line)
                except BrokenPipeError:
                    pass
            if not emitted:
                try:
                    emitted = emit_host_link(port, line)
                except BrokenPipeError:
                    pass

    try:
        consume(echo=True)
    except KeyboardInterrupt:
        # Ctrl-C is handled by the container entry. Keep draining so podman
        # can finish its graceful shutdown without blocking on a full pipe.
        try:
            consume(echo=False)
        except (KeyboardInterrupt, BrokenPipeError):
            pass
    finally:
        stdout.close()
    try:
        return proc.wait()
    except KeyboardInterrupt:
        return proc.wait()


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="run-dsh",
        description="Run the DeepSeek Harness dev container (dev-dsh) with host caches/state "
                    "mounted, attached to the server logs (Ctrl-D/Ctrl-C stops it), "
                    "or serve ACP over stdio with --acp.",
        epilog="Non-flag arguments are passed to the container app (`dsh web`, or "
               "`dsh --profile acp` with --acp; use -- to start them). Script options "
               "must come before `--`/`--exec`: everything after is container-side.",
    )
    p.add_argument("--shell", action="store_true",
                   help="drop into an interactive bash shell instead of the server "
                        "(no port is published)")
    p.add_argument("--acp", action="store_true",
                   help="serve the ACP stdio transport instead of the web UI "
                        "(for agent-shell/acp.el; no port is published, stdin/stdout "
                        "belong to the ACP client)")
    p.add_argument("--exec", dest="exec_cmd", nargs=argparse.REMAINDER, metavar="CMD",
                   help="run CMD... as-is instead of the server (e.g. --exec dsh --help)")
    p.add_argument("--engine", default="auto", metavar="ENGINE",
                   help="container engine: podman, docker, or auto (default: auto)")
    p.add_argument("--image", default=IMAGE, metavar="TAG",
                   help=f"image to run (default: {IMAGE})")
    p.add_argument("--no-selinux", dest="selinux", action="store_false", default=True,
                   help="omit the :z suffix on bind mounts (non-SELinux hosts)")
    p.add_argument("--env", action="append", default=[], metavar="KEY[=VALUE]",
                   help="extra env var to pass into the container (repeatable); "
                        "KEY alone passes the host value through")
    p.add_argument("--dry-run", action="store_true",
                   help="print the command and exit without running it")
    p.add_argument("agent_args", nargs="*", metavar="ARG",
                   help="extra arguments forwarded to the container app")
    args = p.parse_args(argv)
    # argparse cannot express mutual exclusion with --exec's REMAINDER, so
    # reject the combination explicitly. (--acp after --exec is container-side,
    # like every other argument there.)
    if args.acp and (args.shell or args.exec_cmd):
        p.error("--acp cannot be combined with --shell or --exec")
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    home = Path.home()
    pwd = Path.cwd()
    project_state = pwd / PROJECT_STATE_DIR
    engine = resolve_engine(args.engine)

    ensure_mount_sources(home, pwd)

    # ACP owns stdin/stdout: attach stdin (-i) but never allocate a TTY, even
    # when run-dsh itself was started from a terminal. `-t` turns on terminal
    # echo and CR/LF translation, both of which corrupt ACP JSON-RPC framing.
    # Web mode keeps its interactive terminal when stdin is a TTY.
    if args.acp:
        cmd = [engine, "run", "--rm", "-i"]
    else:
        cmd = [engine, "run", "--rm", "-it" if sys.stdin.isatty() else "-i"]
    for spec in build_mounts(home, pwd, args.selinux):
        cmd += ["-v", spec]
    cmd += ["-w", str(pwd)]
    # Project-local DSH data; the container entry uses these to apply the
    # project-workspace patch. They are defaults: a later --env wins.
    # DSH_DEV_CONTAINER marks a run-dsh launch (visible to the agent's
    # shell); DSH_GIT_READ_ONLY mirrors the read-only .git mount that
    # build_mounts adds, so the prompt describes the actual layout.
    project_envs = [
        f"DSH_PROJECT_DIR={pwd}",
        f"DSH_PROJECT_HOME={project_state}",
        f"DSH_PROJECT_SESSIONS={project_state / 'sessions'}",
        f"DSH_PROJECT_STORAGES={project_state / 'storages'}",
        "DSH_DEV_CONTAINER=1",
    ]
    if has_git_dir(pwd):
        project_envs.append("DSH_GIT_READ_ONLY=1")
    for env in build_envs(project_envs + args.env,
                          forward_searxng=engine == "podman"):
        cmd += ["-e", env]

    port: int | None = None
    # -T 7331 forwards only container loopback port 7331 to the same port on
    # host loopback for SearXNG. Docker has no equivalent: publish SearXNG on
    # a host-reachable address and override SEARXNG_URL instead.
    podman_network = ["--network", "pasta:-T,7331"] if engine == "podman" else []
    if args.acp:
        # Same mounts, cwd, env and SearXNG loopback forwarding as web mode,
        # but no published port and no --host-lo-to-ns-lo (there is no port to
        # translate). The entrypoint owns stdout for ACP.
        cmd += podman_network + [args.image, ACP_ENTRY] + args.agent_args
        if args.dry_run:
            print(" ".join(shlex.quote(c) for c in cmd))
            return 0
        if sys.stdin.isatty():
            print("run-dsh: warning: --acp expects an ACP client on stdin; "
                  "stdin is a terminal, so no handshake will arrive",
                  file=sys.stderr, flush=True)
        # Replace the launcher with podman/docker: stdio passes through
        # untouched, the client's signals reach the container engine, and the
        # container's exit status is this process's exit status. No banner,
        # log streaming, port picking, or URL parsing is involved.
        try:
            os.execvp(cmd[0], cmd)
        except OSError as exc:
            print(f"run-dsh: cannot execute {cmd[0]}: {exc}", file=sys.stderr)
            return 127
    if args.shell:
        cmd += podman_network + [args.image, "bash"]
    elif args.exec_cmd:
        cmd += podman_network + [args.image] + args.exec_cmd
    else:
        port = pick_free_port()
        # dsh binds only the container's loopback, and pasta forwards
        # published ports to the namespace's public address by default;
        # --host-lo-to-ns-lo delivers connections made to a host loopback
        # address (our -p bind below) to the namespace loopback instead.
        # Docker has no equivalent: its DNAT only reaches the bridge.
        if podman_network:
            cmd += [podman_network[0], "pasta:--host-lo-to-ns-lo,-T,7331"]
        cmd += ["-p", f"{HOST_BIND}:{port}:{CONTAINER_PORT}"]
        # dsh >= 0.2.0 dropped --public-url: the server prints its
        # container-side URL and the startup banner explains the 127.0.0.1
        # mapping; --trusted-host admits that mapped authority at the /api
        # browser-trust fence. Keep it last: it is variadic (<authority...>)
        # and would swallow bare positional args passed via `run-dsh -- ...`.
        cmd += [args.image, ENTRY]
        cmd += args.agent_args
        cmd += ["--trusted-host", f"{HOST_BIND}:{port}"]

    if args.dry_run:
        print(" ".join(shlex.quote(c) for c in cmd))
        return 0

    if port is not None:
        mode = permission_mode(args.env)
        approval = "never" if mode == "danger-full-access" else "ask"
        print(f"dsh web (host): http://{HOST_BIND}:{port} — full URL with token below")
        print(f"workspace:      {pwd}")
        print(f"dsh state:      {project_state}")
        print(f"permissions:    {mode} (approval {approval})")
        print("stop:           Ctrl-D or Ctrl-C")
    if port is None:
        rc = subprocess.run(cmd).returncode
    else:
        rc = run_streaming(cmd, port)
    if rc != 0:
        print(f"run-dsh: container exited with code {rc} — retry with "
              "`run-dsh --exec <cmd>` to see the error", file=sys.stderr)
    return rc


if __name__ == "__main__":
    sys.exit(main())
