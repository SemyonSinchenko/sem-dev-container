#!/usr/bin/env python3
"""
run-pa — run the prime-agent dev container (dev-prime-agent) with host
caches/state mounted.

Standalone counterpart of bins/run-pi, for the prime-agent harness. Symlink
into ~/.local/bin alongside run-pi.

Examples:
  run-pa                       # start prime-agent in $PWD
  run-pa agents                # browse sessions  (=> prime-agent agents)
  run-pa status                # inspect background services
  run-pa attach <agent>        # reattach to a running session
  run-pa --shell               # drop into bash inside the container
                               #   (e.g. to resume / manage sessions)
  run-pa --exec prime-agent --help
  run-pa --engine docker       # use docker instead of podman
  run-pa --dry-run             # print the command instead of running it

Anything after "--" (or bare positionals) is passed to the `prime-agent`
binary.
"""

from __future__ import annotations

import argparse
import shlex
import subprocess
import sys
from pathlib import Path

# Shared launcher helpers live next to the real script (bins/devc_common.py);
# resolve() follows the ~/.local/bin symlink back to the repo.
sys.path.insert(0, str(Path(__file__).resolve().parent))
try:
    import devc_common as dc
except ImportError:
    sys.exit("run-pa: bins/devc_common.py not found next to the real "
             "script; install the launcher as a symlink (see README)")

AGENT = "prime-agent"           # binary run inside the container
IMAGE = "dev-prime-agent"       # default image (override with --image)
STATE_DIR = ".prime"            # host $HOME/.prime  ->  /root/.prime (agent state)
VOLUME_PREFIX = "pa-target"     # named volume per project: pa-target<escaped pwd> -> /target

# Env vars copied into the container when set on the host (`-e KEY` passes
# the host value through; unset keys are skipped). Provider keys per
# https://github.com/PrimeIntellect-ai/prime-agent providers docs.
PASSTHROUGH_KEYS = [
    "ZAI_API_KEY",
    "DEEPSEEK_API_KEY",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "OPENROUTER_API_KEY",
    "GEMINI_API_KEY",
    "XAI_API_KEY",
    "PRIME_API_KEY",
]


def ensure_mount_sources(home: Path, pwd: Path) -> None:
    """Create host dirs that will be bind-mounted (podman refuses to create them)."""
    dirs = [
        pwd,
        home / STATE_DIR,
        *dc.cache_dirs(home),
    ]
    for d in dirs:
        d.mkdir(parents=True, exist_ok=True)


def build_mounts(home: Path, pwd: Path, selinux: bool) -> list[str]:
    """-v specs: bind mounts (host:container) + the per-project named volume."""
    z = ":z" if selinux else ""
    specs = [
        f"{pwd}:{pwd}{z}",
        f"{home / STATE_DIR}:/root/{STATE_DIR}{z}",
        *dc.cache_mounts(home, z),
    ]
    # Re-mount .git read-only over the rw project mount above (a later -v
    # entry wins; see APPEND_SYSTEM.md): commits belong on the host.
    specs += dc.git_ro_mount(pwd, selinux)
    # Named (docker-managed) volume, one per host project dir, so builds
    # survive container teardown and are shared across runs.
    specs.append(f"{dc.target_volume(VOLUME_PREFIX, pwd)}:/target")
    return specs


def build_tmpfs_mounts() -> list[str]:
    """Container-private state nested beneath the shared ~/.prime bind mount.

    Daemon worker descriptors identify their supervisor by the socket-path
    string. Every container's private /tmp gives the default daemon the same
    string (/tmp/prime-agent-0/daemon.sock), so persisting descriptors in the
    host-mounted ~/.prime makes a later container try to adopt workers that
    only existed in an earlier container. Unlike sessions, worker descriptors
    and their recovery journals have exactly the lifetime of the container.
    """
    # Prime Agent's agentDir is ~/.prime/agent (not ~/.prime itself).
    return ["/root/.prime/agent/daemon-workers:rw,mode=0700"]


def build_envs(extra: list[str], *, forward_searxng: bool = False) -> list[str]:
    """-e specs: fixed, then passthrough keys set on the host, then --env extras
    (last one wins; see devc_common.merge_envs)."""
    envs: dict[str, str] = {
        "CARGO_TARGET_DIR": "CARGO_TARGET_DIR=/target",
        # Container-private daemon supervisor registry. The default location
        # (~/.prime/supervisor-owners) is shared with the host and other
        # containers through the ~/.prime bind mount, but its records
        # arbitrate *local* daemons by socket-path string + pid — both
        # meaningless across containers, so concurrent runs corrupt each
        # other's ownership ("supervisor generation ... no longer owns its
        # registry entry"). /tmp is container-private and a container lives
        # exactly as long as its daemon. Keep in sync with
        # prime-agent/Dockerfile.
        "PRIME_AGENT_INTERNAL_DAEMON_SUPERVISOR_REGISTRY_DIR":
            "PRIME_AGENT_INTERNAL_DAEMON_SUPERVISOR_REGISTRY_DIR=/tmp/prime-agent-supervisor-owners",
    }
    return dc.merge_envs(envs, PASSTHROUGH_KEYS, extra,
                         forward_searxng=forward_searxng)


def build_container_command(args: argparse.Namespace) -> list[str]:
    """What to run inside the container (--shell > --exec > agent + args)."""
    if args.shell:
        return ["bash"]
    if args.exec_cmd:
        return args.exec_cmd
    if args.agent_args:
        return [AGENT] + args.agent_args
    return [AGENT]


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="run-pa",
        description="Run the prime-agent dev container (dev-prime-agent) with host caches/state mounted.",
        epilog="Non-flag arguments are passed to the `prime-agent` binary (use -- to start them). "
               "Script options must come before `--`/`--exec`: everything after is container-side.",
    )
    p.add_argument("--shell", action="store_true",
                   help="drop into an interactive bash shell instead of the agent")
    p.add_argument("--exec", dest="exec_cmd", nargs=argparse.REMAINDER, metavar="CMD",
                   help="run CMD... as-is instead of the agent; consumes every following arg "
                        "(e.g. --exec prime-agent --help)")
    p.add_argument("--engine", default="auto", metavar="ENGINE",
                   help="container engine: podman, docker, or auto (default: auto)")
    p.add_argument("--image", default=IMAGE, metavar="TAG",
                   help=f"image to run (default: {IMAGE})")
    p.add_argument("--no-selinux", dest="selinux", action="store_false", default=True,
                   help="omit the :z suffix on bind mounts (non-SELinux hosts)")
    p.add_argument("--env", action="append", default=[], metavar="KEY[=VALUE]",
                   help="extra env var to pass into the container (repeatable); "
                        "KEY alone passes the host value through")
    p.add_argument("--dry-run", action="store_true",
                   help="print the command and exit without running it")
    p.add_argument("agent_args", nargs="*", metavar="ARG",
                   help="extra arguments forwarded to the agent binary")
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    home = Path.home()
    pwd = Path.cwd()
    engine = dc.resolve_engine(args.engine)

    ensure_mount_sources(home, pwd)

    cmd = [engine, "run", "--rm", "-it" if sys.stdin.isatty() else "-i"]
    for spec in build_mounts(home, pwd, args.selinux):
        cmd += ["-v", spec]
    # This nested tmpfs masks only daemon-lifetime state; ~/.prime's sessions,
    # auth, and configuration remain on the host bind mount above.
    for target in build_tmpfs_mounts():
        cmd += ["--tmpfs", target]
    cmd += ["-w", str(pwd)]
    for env in build_envs(args.env, forward_searxng=engine == "podman"):
        cmd += ["-e", env]
    # Forward only container 127.0.0.1:7331 to host 127.0.0.1:7331 for the
    # host SearXNG service. Docker has no equivalent: publish the service port
    # on a host-reachable address and override SEARXNG_URL instead.
    if engine == "podman":
        cmd += ["--network", "pasta:-T,7331"]
    cmd.append(args.image)
    cmd += build_container_command(args)

    if args.dry_run:
        print(" ".join(shlex.quote(c) for c in cmd))
        return 0
    return subprocess.run(cmd).returncode


if __name__ == "__main__":
    sys.exit(main())
