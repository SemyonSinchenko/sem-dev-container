#!/usr/bin/env python3
"""
run-codex — run the Codex dev container (dev-codex) with host caches/state
mounted.

By default it starts the interactive `codex` TUI in the current project.
`run-codex --acp` runs the same container (same project mount, state, caches
and environment) as a foreground ACP stdio server instead: stdin/stdout are
inherited by `codex-acp-entry` -> `codex-acp`. The launcher execs
podman/docker, so the ACP client (agent-shell/acp.el in Emacs) owns the pipes,
signals, and exit status. stdout is protocol-only; diagnostics go to stderr.
No pseudo-TTY is allocated even when stdin is a terminal, because terminal
echo and CR/LF translation corrupt ACP framing.

State is split like run-claude's: the host's ~/.codex is mounted at
/root/.codex (CODEX_HOME) for shared, project-agnostic state (auth.json,
config.toml, AGENTS.md, skills, rules), and the per-session state entries
(rollouts, archived sessions, memories, shell snapshots, prompt history, and
the SQLite home with the thread index) are over-mounted from
<project>/.codex-container, so sessions stay with the project. Add
.codex-container/ to the project's .gitignore.

The image applies a container policy through /etc/codex/managed_config.toml
(developer instructions with the runtime facts, project trust) and a `codex`
wrapper that sets the sandbox/approval mode. Sessions start in
agent-full-access: the launcher exports CODEX_PERMISSION_MODE=agent-full-access.
Isolation is the operator's responsibility. Override one run with
`--env CODEX_PERMISSION_MODE=read-only`.

OPENAI_API_KEY is deliberately not passed through: Codex uses the ChatGPT
login stored in ~/.codex/auth.json. Opt in for one run with
`--env OPENAI_API_KEY`. See README.md.

Examples:
  run-codex                        # start the codex TUI in $PWD
  run-codex -- resume --last       # args after -- go to `codex` (container side)
  run-codex --acp                  # serve ACP over stdio instead (agent-shell/acp.el)
  run-codex --shell                # drop into bash in the container
  run-codex --exec codex login --device-auth
  run-codex --engine docker        # use docker instead of podman
  run-codex --dry-run              # print the command instead of running it

Multi-agent runs (README: "Roles and capability profiles"):
  --role NAME        own session state (<project>/.codex-container/roles/NAME),
                     own /target volume (codex-target.NAME<escaped pwd>;
                     --shared-target keeps the legacy one), AGENT_ROLE and the
                     sem.harness/sem.project/sem.role labels. One container per
                     role and project at a time (a lock in the role dir;
                     --allow-duplicate-role skips it).
  --mount ro|overlay project read-only, or a throwaway podman overlay whose
                     changes never reach the host. The session state mounts
                     live outside the project, so they persist in every mode.
                     An explicit --mount exports AGENT_MOUNT_MODE.
  --outbox DIR       one project subdir bind-mounted rw on top: where results
                     go under ro/overlay; exported as AGENT_OUTBOX.
  --label KEY=VALUE, --name NAME, --timeout SECONDS (podman only; exit 255
                     on expiry) are passed to the engine.
Without these options nothing changes.

Script options must come before `--` or `--exec`; everything after is
container-side.
"""

from __future__ import annotations

import argparse
import os
import shlex
import subprocess
import sys
from pathlib import Path

# Shared launcher helpers live next to the real script (bins/devc_common.py);
# resolve() follows the ~/.local/bin symlink back to the repo.
sys.path.insert(0, str(Path(__file__).resolve().parent))
try:
    import devc_common as dc
except ImportError:
    sys.exit("run-codex: bins/devc_common.py not found next to the real "
             "script; install the launcher as a symlink (see README)")

AGENT = "codex"                     # TUI binary run inside the container
IMAGE = "dev-codex"                 # default image (override with --image)
ACP_ENTRY = "codex-acp-entry"       # foreground ACP stdio entry installed by codex/Dockerfile
STATE_DIR = ".codex"                # host $HOME/.codex  ->  /root/.codex (CODEX_HOME)
PROJECT_STATE_DIR = ".codex-container"  # <project>/.codex-container: per-project session state
AGENTS_DIR = ".agents"              # host $HOME/.agents (shared skills, as for run-claude)
VOLUME_PREFIX = "codex-target"      # named volume per project: codex-target<escaped pwd> -> /target

# Entries of CODEX_HOME that hold per-session state. Each one is over-mounted
# from <project>/.codex-container/<name>, so it stays with the project;
# everything else in ~/.codex stays shared with the host. `sessions` holds
# the rollouts and `sqlite` is CODEX_SQLITE_HOME (set in codex/Dockerfile):
# the thread index session/list reads, plus logs, memories, goals and queue
# databases. `memories` holds summaries derived from past rollouts.
PROJECT_STATE_DIRS = [
    "sessions",
    "archived_sessions",
    "sqlite",
    "memories",
    "shell_snapshots",
    "thread-writer-locks",
    "log",
]
# Single-file entries: pre-created so the file bind mount has a source.
PROJECT_STATE_FILES = ["history.jsonl"]

# Codex mode (codex-acp mode id) every session starts in (see codex-dev-entry).
DEFAULT_PERMISSION_MODE = "agent-full-access"

# Env vars copied into the container when set on the host (`-e KEY` passes
# the host value through; unset keys are skipped). Same list as run-dsh minus
# OPENAI_API_KEY, which would offer Codex API billing instead of the ChatGPT
# login.
PASSTHROUGH_KEYS = [
    "ZAI_API_KEY",
    "DEEPSEEK_API_KEY",
    "ANTHROPIC_API_KEY",
    "OPENROUTER_API_KEY",
    "GEMINI_API_KEY",
    "XAI_API_KEY",
    "PRIME_API_KEY",
]


def project_state_dir(pwd: Path, role: str | None) -> Path:
    """Where the per-session state entries live: per project, or per role."""
    if role is None:
        return pwd / PROJECT_STATE_DIR
    return pwd / PROJECT_STATE_DIR / "roles" / role


def ensure_mount_sources(home: Path, pwd: Path, project_state: Path) -> None:
    """Create host dirs/files that will be bind-mounted (podman refuses to create them)."""
    dirs = [
        pwd,
        home / STATE_DIR,
        home / AGENTS_DIR,
        *dc.cache_dirs(home),
    ] + [project_state / name for name in PROJECT_STATE_DIRS]
    for d in dirs:
        d.mkdir(parents=True, exist_ok=True)
    for name in PROJECT_STATE_FILES:
        (project_state / name).touch(exist_ok=True)


def build_mounts(home: Path, pwd: Path, selinux: bool, project_state: Path,
                 volume: str, mode: str = "rw",
                 outbox: Path | None = None) -> list[str]:
    """-v specs: bind mounts (host:container) + the per-project named volume."""
    z = ":z" if selinux else ""
    codex_home = f"/root/{STATE_DIR}"
    specs = [
        dc.project_mount(pwd, mode, selinux),
        f"{home / STATE_DIR}:{codex_home}{z}",
        f"{home / AGENTS_DIR}:/root/{AGENTS_DIR}{z}",
        *dc.cache_mounts(home, z),
    ]
    # Over-mount the per-session state entries on top of the shared
    # ~/.codex mount above (a later -v entry wins), so rollouts and the
    # thread index land in <project>/.codex-container while auth and config
    # stay shared with the host. The shared dir itself stays a directory
    # mount: auth.json and config.toml may be rewritten by rename, which a
    # single-file bind mount cannot survive. With --role, project_state is
    # the role's own dir, so parallel roles never share sessions.
    for name in PROJECT_STATE_DIRS + PROJECT_STATE_FILES:
        specs.append(f"{project_state / name}:{codex_home}/{name}{z}")
    # Re-mount .git read-only over the project mount above (see
    # APPEND_SYSTEM.md): commits belong on the host.
    specs += dc.git_ro_mount(pwd, selinux)
    # The outbox stays writable and persistent whatever the project mode.
    specs += dc.outbox_mount(outbox, selinux)
    # Named (docker-managed) volume, one per host project dir, so builds the
    # agent runs in the workspace keep their target dir across runs.
    specs.append(f"{volume}:/target")
    return specs


def build_envs(extra: list[str], *, forward_searxng: bool = False) -> list[str]:
    """-e specs: fixed, then passthrough keys set on the host, then --env extras
    (last one wins; see devc_common.merge_envs)."""
    fixed = {
        "CARGO_TARGET_DIR": "CARGO_TARGET_DIR=/target",
        # The container is a single-purpose isolation boundary, so every
        # session starts in agent-full-access. A later --env
        # CODEX_PERMISSION_MODE=... in `extra` replaces this default.
        "CODEX_PERMISSION_MODE": f"CODEX_PERMISSION_MODE={DEFAULT_PERMISSION_MODE}",
    }
    return dc.merge_envs(fixed, PASSTHROUGH_KEYS, extra,
                         forward_searxng=forward_searxng)


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="run-codex",
        description="Run the Codex dev container (dev-codex) with host caches/state "
                    "mounted: the codex TUI by default, or an ACP stdio server with --acp.",
        epilog="Non-flag arguments are passed to the container app (`codex`, or "
               "`codex-acp` with --acp; use -- to start them). Script options "
               "must come before `--`/`--exec`: everything after is container-side.",
    )
    p.add_argument("--shell", action="store_true",
                   help="drop into an interactive bash shell instead of the agent")
    p.add_argument("--acp", action="store_true",
                   help="serve the ACP stdio transport instead of the TUI "
                        "(for agent-shell/acp.el; stdin/stdout belong to the ACP client)")
    p.add_argument("--exec", dest="exec_cmd", nargs=argparse.REMAINDER, metavar="CMD",
                   help="run CMD... as-is instead of the agent (e.g. --exec codex login)")
    p.add_argument("--engine", default="auto", metavar="ENGINE",
                   help="container engine: podman, docker, or auto (default: auto)")
    p.add_argument("--image", default=IMAGE, metavar="TAG",
                   help=f"image to run (default: {IMAGE})")
    p.add_argument("--no-selinux", dest="selinux", action="store_false", default=True,
                   help="omit the :z suffix on bind mounts (non-SELinux hosts)")
    p.add_argument("--env", action="append", default=[], metavar="KEY[=VALUE]",
                   help="extra env var to pass into the container (repeatable); "
                        "KEY alone passes the host value through")
    p.add_argument("--dry-run", action="store_true",
                   help="print the command and exit without running it")
    dc.add_role_args(p)
    dc.add_mount_args(p)
    dc.add_outbox_args(p)
    dc.add_identity_args(p)
    p.add_argument("agent_args", nargs="*", metavar="ARG",
                   help="extra arguments forwarded to the container app")
    args = p.parse_args(argv)
    # argparse cannot express mutual exclusion with --exec's REMAINDER, so
    # reject the combination explicitly. (--acp after --exec is container-side,
    # like every other argument there.)
    if args.acp and (args.shell or args.exec_cmd):
        p.error("--acp cannot be combined with --shell or --exec")
    dc.check_role_args(p, args)
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    home = Path.home()
    pwd = Path.cwd()
    engine = dc.resolve_engine(args.engine)
    dc.check_engine_support(args, engine, "run-codex")
    outbox = dc.resolve_outbox(pwd, args.outbox, "run-codex")
    project_state = project_state_dir(pwd, args.role)
    volume = dc.target_volume(VOLUME_PREFIX, pwd, args.role, args.shared_target)

    ensure_mount_sources(home, pwd, project_state)
    dc.ensure_outbox(outbox)
    # One container per role and project: two would share one role dir.
    # Taken under --dry-run too (released at exit), so the guard is testable.
    if args.role is not None and not args.allow_duplicate_role:
        dc.acquire_role_lock(project_state / ".lock", args.role, "run-codex")

    # ACP owns stdin/stdout: attach stdin (-i) but never allocate a TTY, even
    # when run-codex itself was started from a terminal. `-t` turns on
    # terminal echo and CR/LF translation, both of which corrupt ACP JSON-RPC
    # framing. The TUI keeps its interactive terminal when stdin is a TTY.
    if args.acp:
        cmd = [engine, "run", "--rm", "-i"]
    else:
        cmd = [engine, "run", "--rm", "-it" if sys.stdin.isatty() else "-i"]
    cmd += dc.engine_run_options(AGENT, pwd, args)
    for spec in build_mounts(home, pwd, args.selinux, project_state, volume,
                             dc.mount_mode(args), outbox):
        cmd += ["-v", spec]
    cmd += ["-w", str(pwd)]
    # CODEX_PROJECT_HOME tells codex-acp-entry that the per-project
    # over-mounts are expected (it refuses to run with shared sessions
    # otherwise). CODEX_DEV_CONTAINER marks a run-codex launch (visible to
    # the agent's shell); CODEX_GIT_READ_ONLY mirrors the read-only .git
    # mount that build_mounts adds. They are defaults: a later --env wins.
    project_envs = [
        f"CODEX_PROJECT_HOME={project_state}",
        "CODEX_DEV_CONTAINER=1",
    ]
    if dc.has_git_dir(pwd):
        project_envs.append("CODEX_GIT_READ_ONLY=1")
    if args.role is not None:
        project_envs.append(f"AGENT_ROLE={args.role}")
    project_envs += dc.mount_envs(args)
    project_envs += dc.outbox_envs(outbox)
    for env in build_envs(project_envs + args.env,
                          forward_searxng=engine == "podman"):
        cmd += ["-e", env]
    # -T 7331 forwards only container loopback port 7331 to the same port on
    # host loopback for SearXNG. Docker has no equivalent: publish SearXNG on
    # a host-reachable address and override SEARXNG_URL instead.
    if engine == "podman":
        cmd += ["--network", "pasta:-T,7331"]
    cmd.append(args.image)

    if args.acp:
        cmd += [ACP_ENTRY] + args.agent_args
        if args.dry_run:
            print(" ".join(shlex.quote(c) for c in cmd))
            return 0
        if sys.stdin.isatty():
            print("run-codex: warning: --acp expects an ACP client on stdin; "
                  "stdin is a terminal, so no handshake will arrive",
                  file=sys.stderr, flush=True)
        # Replace the launcher with podman/docker: stdio passes through
        # untouched, the client's signals reach the container engine, and the
        # container's exit status is this process's exit status.
        try:
            os.execvp(cmd[0], cmd)
        except OSError as exc:
            print(f"run-codex: cannot execute {cmd[0]}: {exc}", file=sys.stderr)
            return 127
    if args.shell:
        cmd.append("bash")
    elif args.exec_cmd:
        cmd += args.exec_cmd
    else:
        cmd += [AGENT] + args.agent_args

    if args.dry_run:
        print(" ".join(shlex.quote(c) for c in cmd))
        return 0
    return subprocess.run(cmd).returncode


if __name__ == "__main__":
    sys.exit(main())
