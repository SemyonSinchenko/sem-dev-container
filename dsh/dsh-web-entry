#!/usr/bin/env bash
# dsh-web-entry — foreground wrapper for `dsh web` inside the dev-dsh
# container; the CMD behind bins/run-dsh.
#
# The launcher attaches a terminal and streams the server logs. This script
# stops the harness and exits the container when
#   - you press Ctrl-D (stdin hits EOF),
#   - you press Ctrl-C (SIGINT; dsh shuts itself down gracefully),
#   - the server exits by itself (crash or completion), or
#   - podman stop TERMs this process (relayed as dsh's stop request).
# The script's exit status is the harness's.
#
# dsh >= 0.2.0 only ever binds a loopback address: 0.0.0.0 is refused at
# runtime ("would expose remote code execution to the network"). Reaching
# that loopback through podman's published port needs pasta's
# --host-lo-to-ns-lo (passed by bins/run-dsh): without it pasta forwards
# connections to a host loopback address to the namespace's public
# address, where nothing listens. The container-side port stays fixed
# (override: DSH_PORT).
#
# Extra flags after these are forwarded to `dsh web` (see run-dsh --).
#
# When bins/run-dsh exports DSH_PROJECT_HOME, load the project-workspace
# overlay: it points session persistence, storage, and attachments at
# <project>/.dsh and registers that folder as the session workspace. ~/.dsh
# stays the shared config home (profiles, credentials, global instructions).
# The searxng-search overlay is always loaded; it routes the native
# web_search tool through the host's SearXNG instance.

set -u

# Save the real stdin before any backgrounding: without job control a
# non-interactive shell gives asynchronous commands stdin from /dev/null,
# so the watcher below would see EOF at t=0 and TERM the harness at birth
# (the silent exit-143 failure). An explicit <&3 redirection overrides
# that implicit assignment; fd 3 is inherited by the subshell.
exec 3<&0

profile="${DSH_PROFILE:-web}"
patch_args=()
add_patch() {
    if [ -f "$1" ]; then
        patch_args+=(--patch "$1")
    else
        echo "dsh-web-entry: warning: $1 missing; continuing without it" >&2
    fi
}
if [ -n "${DSH_PROJECT_HOME:-}" ]; then
    add_patch /usr/local/share/dsh/project-workspace.patch.yml
fi
add_patch /usr/local/share/dsh/searxng-search.patch.yml
# Image-local deployment policy: container runtime context + git-write guard,
# and the permission default derived from DSH_PERMISSION_MODE.
add_patch /usr/local/share/dsh/dev-container.patch.yml
add_patch /usr/local/share/dsh/permission.patch.yml

# --patch is a launcher flag: it must come before the app's own flags.
dsh --profile "$profile" "${patch_args[@]}" \
    --host 127.0.0.1 --port "${DSH_PORT:-3080}" --no-open "$@" &
pid=$!

# stdin watcher: read the attached terminal until EOF (Ctrl-D), then stop the
# harness. The subshell ignores SIGINT — Ctrl-C must interrupt only the
# harness (the TTY line discipline signals the whole foreground group).
( trap '' INT; cat <&3 >/dev/null 2>&1; kill -TERM "$pid" 2>/dev/null ) &
feeder=$!

# Ctrl-C hits this script too; stay alive so dsh's own graceful shutdown
# can finish. `podman stop` TERMs PID 1 only — relay it as the harness's
# stop request.
trap ':' INT
trap 'kill -TERM "$pid" 2>/dev/null' TERM

# Park here until the harness exits. A trapped signal interrupts the wait
# with status >= 128 while the child is still alive: keep waiting. Once
# wait reaps the child, its status is the result.
status=0
while :; do
    wait "$pid"; status=$?
    kill -0 "$pid" 2>/dev/null || break
done
kill "$feeder" 2>/dev/null
wait "$feeder" 2>/dev/null
feeder_status=$?
# A feeder that finished on its own read stdin to EOF (Ctrl-D): that stop
# was deliberate, so report success instead of the TERM status we sent the
# harness; any other status (crash, podman stop) propagates untouched.
if [ "$feeder_status" -eq 0 ] && [ "$status" -eq 143 ]; then
    status=0
fi
exit "$status"
