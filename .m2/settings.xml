<?xml version="1.0" encoding="UTF-8"?>
<!--
  Global Maven settings for the dev container.

  Redirects the local repository to /cache/maven so a host bind-mount
  (e.g.  -v ~/.m2/repository:/cache/maven) shares downloaded artifacts across
  builds and keeps them out of the container's writable layer.

  Installed to /opt/maven/conf/settings.xml, the GLOBAL settings file, so it
  applies to every user/UID regardless of HOME (including the keep-id user
  namespace with an arbitrary host UID that has no ~/.m2).

  This replaces the previous MAVEN_OPTS repo-local hack, which clobbered any
  user-supplied JVM or memory flags (e.g.  MAVEN_OPTS="-Xmx4g") because it
  overwrote the whole variable. MAVEN_OPTS is now free for JVM args.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <localRepository>/cache/maven</localRepository>
</settings>
